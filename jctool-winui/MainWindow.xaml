<Window
    x:Class="JcTool.WinUI.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:models="using:JcTool.WinUI.Models"
    xmlns:services="using:JcTool.WinUI.Services">

    <Grid x:Name="RootGrid"
          RequestedTheme="Dark"
          Background="{StaticResource AppBackgroundBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="48" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="36" />
        </Grid.RowDefinitions>

        <Grid x:Name="AppTitleBar"
              Grid.Row="0"
              Padding="16,0,142,0"
              Background="{StaticResource AppBackgroundBrush}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <FontIcon Glyph="&#xE7FC;"
                      FontSize="18"
                      Foreground="{StaticResource AccentBrush}" />
            <TextBlock Grid.Column="1"
                       services:Localized.Key="AppTitle.Text"
                       Margin="10,0,0,0"
                       VerticalAlignment="Center"
                       FontSize="14"
                       FontWeight="SemiBold" />
        </Grid>

        <Border Grid.Row="1"
                Padding="16,12"
                Background="{StaticResource SurfaceBrush}"
                BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="0,1,0,1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <ItemsRepeater ItemsSource="{x:Bind ViewModel.Devices}">
                    <ItemsRepeater.Layout>
                        <UniformGridLayout MaximumRowsOrColumns="4"
                                           MinItemWidth="154"
                                           MinItemHeight="72"
                                           MinColumnSpacing="10"
                                           ItemsJustification="SpaceBetween"
                                           ItemsStretch="Fill" />
                    </ItemsRepeater.Layout>
                    <ItemsRepeater.ItemTemplate>
                        <DataTemplate x:DataType="models:ControllerSlot">
                            <Button Tag="{x:Bind SlotIndex}"
                                    Margin="0,0,10,0"
                                    Padding="12,8"
                                    HorizontalAlignment="Stretch"
                                    HorizontalContentAlignment="Stretch"
                                    VerticalContentAlignment="Stretch"
                                    Click="DeviceButton_Click"
                                    AutomationProperties.Name="{x:Bind DisplayName, Mode=OneWay}">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>
                                    <TextBlock Foreground="{StaticResource TextSecondaryBrush}"
                                               FontSize="10"
                                               FontWeight="SemiBold"
                                               Text="{x:Bind SlotLabel}" />
                                    <TextBlock Grid.Row="1"
                                               Margin="0,2,0,0"
                                               FontSize="13"
                                               FontWeight="SemiBold"
                                               Text="{x:Bind DisplayName, Mode=OneWay}"
                                               TextTrimming="CharacterEllipsis"
                                               TextWrapping="NoWrap" />
                                    <TextBlock Grid.Row="2"
                                               Margin="0,2,0,0"
                                               Foreground="{StaticResource TextSecondaryBrush}"
                                               FontSize="11"
                                               Text="{x:Bind StatusText, Mode=OneWay}"
                                               TextTrimming="CharacterEllipsis"
                                               TextWrapping="NoWrap" />
                                </Grid>
                            </Button>
                        </DataTemplate>
                    </ItemsRepeater.ItemTemplate>
                </ItemsRepeater>

                <Button x:Name="RefreshButton"
                        Grid.Column="1"
                        Width="40"
                        Height="40"
                        Margin="2,0,0,0"
                        VerticalAlignment="Center"
                        IsEnabled="{x:Bind ViewModel.CanStartOperation, Mode=OneWay}"
                        Click="RefreshButton_Click">
                    <FontIcon Glyph="&#xE72C;" FontSize="16" />
                </Button>
            </Grid>
        </Border>

        <NavigationView x:Name="MainNavigation"
                        Grid.Row="2"
                        IsBackButtonVisible="Collapsed"
                        IsSettingsVisible="True"
                        IsTitleBarAutoPaddingEnabled="False"
                        PaneDisplayMode="Auto"
                        OpenPaneLength="220"
                        CompactPaneLength="48"
                        SelectionChanged="NavigationView_SelectionChanged">
            <NavigationView.MenuItems>
                <NavigationViewItem services:Localized.Key="NavOverview.Content" Tag="overview">
                    <NavigationViewItem.Icon>
                        <SymbolIcon Symbol="Home" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem services:Localized.Key="NavColors.Content" Tag="colors">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE790;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem services:Localized.Key="NavCalibration.Content" Tag="calibration">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE9E9;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem services:Localized.Key="NavRumble.Content" Tag="rumble">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE995;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem services:Localized.Key="NavInput.Content" Tag="input">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE7FC;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem services:Localized.Key="NavIr.Content" Tag="ir">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE722;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem services:Localized.Key="NavNfc.Content" Tag="nfc">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE839;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem services:Localized.Key="NavDiagnostics.Content" Tag="diagnostics">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE756;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
            </NavigationView.MenuItems>

            <ContentPresenter x:Name="PageHost" />
        </NavigationView>

        <Grid Grid.Row="3"
              Padding="16,0"
              Background="{StaticResource SurfaceBrush}"
              BorderBrush="{StaticResource BorderBrush}"
              BorderThickness="0,1,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="120" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <ProgressRing Width="16"
                          Height="16"
                          Margin="0,0,8,0"
                          HorizontalAlignment="Left"
                          IsActive="{x:Bind ViewModel.IsBusyIndeterminate, Mode=OneWay}" />
            <ProgressBar Width="112"
                         Height="4"
                         HorizontalAlignment="Left"
                         VerticalAlignment="Center"
                         Minimum="0"
                         Maximum="100"
                         Value="{x:Bind ViewModel.OperationProgress, Mode=OneWay}"
                         Visibility="{x:Bind ViewModel.IsOperationProgressVisible, Mode=OneWay}" />
            <TextBlock Grid.Column="1"
                       VerticalAlignment="Center"
                       Foreground="{StaticResource TextSecondaryBrush}"
                       FontSize="12"
                       Text="{x:Bind ViewModel.StatusText, Mode=OneWay}"
                       TextTrimming="CharacterEllipsis"
                       TextWrapping="NoWrap" />
            <Button Grid.Column="2"
                    Width="32"
                    Height="28"
                    Margin="8,0"
                    Padding="0"
                    IsEnabled="{x:Bind ViewModel.CanCancelOperation, Mode=OneWay}"
                    Visibility="{x:Bind ViewModel.IsOperating, Mode=OneWay}"
                    AutomationProperties.Name="{x:Bind ViewModel.CancelOperationText}"
                    Click="CancelOperationButton_Click"
                    ToolTipService.ToolTip="{x:Bind ViewModel.CancelOperationText}">
                <FontIcon Glyph="&#xE711;" FontSize="12" />
            </Button>
            <TextBlock Grid.Column="3"
                       services:Localized.Key="FooterSession.Text"
                       VerticalAlignment="Center"
                       Foreground="{StaticResource TextSecondaryBrush}"
                       FontSize="11" />
        </Grid>
    </Grid>
</Window>
