<UserControl
    x:Class="JcTool.WinUI.Views.DiagnosticsView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:services="using:JcTool.WinUI.Services">

    <ScrollViewer HorizontalScrollBarVisibility="Disabled"
                  VerticalScrollBarVisibility="Auto">
        <Grid MaxWidth="1080"
              Padding="32,28,32,40"
              HorizontalAlignment="Stretch">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="20" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <TextBlock services:Localized.Key="DiagnosticsHeader.Text"
                       Style="{StaticResource SectionTitleStyle}"
                       FontSize="28" />

            <Grid x:Name="ContentGrid"
                  Grid.Row="2"
                  ColumnSpacing="16"
                  RowSpacing="16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition x:Name="CommandColumn" Width="3*" />
                    <ColumnDefinition x:Name="InfoColumn" Width="2*" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <Border Style="{StaticResource PanelBorderStyle}">
                    <StackPanel Spacing="14">
                        <TextBlock services:Localized.Key="DiagnosticCommandHeader.Text"
                                   FontSize="17"
                                   FontWeight="SemiBold" />
                        <ComboBox x:Name="ModePicker"
                                  services:Localized.Key="DiagnosticMode.Header"
                                  SelectedIndex="0"
                                  HorizontalAlignment="Stretch">
                            <ComboBoxItem services:Localized.Key="DiagnosticModeDebug.Content" Tag="Debug" />
                            <ComboBoxItem services:Localized.Key="DiagnosticModeInternal.Content" Tag="Internal" />
                        </ComboBox>
                        <Grid ColumnSpacing="10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="90" />
                                <ColumnDefinition Width="170" />
                                <ColumnDefinition Width="100" />
                            </Grid.ColumnDefinitions>
                            <TextBox x:Name="CommandBox"
                                     services:Localized.Key="DiagnosticCommand.Header"
                                     Text="01"
                                     MaxLength="2" />
                            <TextBox x:Name="RumbleBox"
                                     Grid.Column="1"
                                     services:Localized.Key="DiagnosticRumble.Header"
                                     Text="00 01 40 40" />
                            <TextBox x:Name="SubcommandBox"
                                     Grid.Column="2"
                                     services:Localized.Key="DiagnosticSubcommand.Header"
                                     Text="02"
                                     MaxLength="2" />
                        </Grid>
                        <TextBox x:Name="ArgumentsBox"
                                 services:Localized.Key="DiagnosticArguments.Header"
                                 AcceptsReturn="True"
                                 MaxLength="76"
                                 TextWrapping="Wrap"
                                 PlaceholderText="00 00 00" />
                        <Grid ColumnSpacing="10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock x:Name="CommandStatusText"
                                       VerticalAlignment="Center"
                                       Foreground="{StaticResource TextSecondaryBrush}"
                                       TextWrapping="Wrap" />
                            <Button x:Name="SendButton"
                                    Grid.Column="1"
                                    Style="{StaticResource PrimaryButtonStyle}"
                                    services:Localized.Key="SendDiagnostic.Content"
                                    Click="SendButton_Click" />
                        </Grid>
                        <TextBox x:Name="ReplyText"
                                 services:Localized.Key="DiagnosticReply.Header"
                                 MinHeight="260"
                                 FontFamily="Consolas"
                                 FontSize="12"
                                 IsReadOnly="True"
                                 AcceptsReturn="True"
                                 TextWrapping="NoWrap"
                                 ScrollViewer.VerticalScrollBarVisibility="Auto" />
                    </StackPanel>
                </Border>

                <Border x:Name="PresetPanel"
                        Grid.Column="1"
                        Style="{StaticResource PanelBorderStyle}">
                    <StackPanel Spacing="14">
                        <TextBlock services:Localized.Key="InternalPresetsHeader.Text"
                                   FontSize="17"
                                   FontWeight="SemiBold" />
                        <TextBlock services:Localized.Key="InternalPresetsWarning.Text"
                                   Foreground="{StaticResource WarningBrush}"
                                   TextWrapping="Wrap" />
                        <Button x:Name="ShipmentButton"
                                services:Localized.Key="SetShipment.Content"
                                Click="ShipmentButton_Click" />
                        <Button x:Name="ClearPairingButton"
                                services:Localized.Key="ClearPairing.Content"
                                Click="ClearPairingButton_Click" />
                        <Button x:Name="RebootPairingButton"
                                services:Localized.Key="RebootPairing.Content"
                                Click="RebootPairingButton_Click" />
                    </StackPanel>
                </Border>

                <Border x:Name="EnvironmentPanel"
                        Grid.Row="1"
                        Grid.ColumnSpan="2"
                        Style="{StaticResource PanelBorderStyle}">
                    <StackPanel Spacing="10">
                        <TextBlock services:Localized.Key="EnvironmentHeader.Text"
                                   FontSize="17"
                                   FontWeight="SemiBold" />
                        <TextBlock x:Name="EnvironmentText"
                                   FontFamily="Consolas"
                                   Foreground="{StaticResource TextSecondaryBrush}"
                                   TextWrapping="Wrap" />
                        <TextBlock services:Localized.Key="DiagnosticSafetyNote.Text"
                                   Foreground="{StaticResource WarningBrush}"
                                   TextWrapping="Wrap" />
                        <Grid ColumnSpacing="10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock x:Name="HardwarePreflightStatusText"
                                       VerticalAlignment="Center"
                                       Foreground="{StaticResource TextSecondaryBrush}"
                                       TextWrapping="Wrap" />
                            <Button x:Name="HardwarePreflightButton"
                                    Grid.Column="1"
                                    services:Localized.Key="RunHardwarePreflight.Content"
                                    Click="HardwarePreflightButton_Click" />
                        </Grid>
                    </StackPanel>
                </Border>
            </Grid>
        </Grid>
    </ScrollViewer>
</UserControl>
