<UserControl
    x:Class="JcTool.WinUI.Views.NfcView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:services="using:JcTool.WinUI.Services">

    <ScrollViewer HorizontalScrollBarVisibility="Disabled"
                  VerticalScrollBarVisibility="Auto">
        <Grid MaxWidth="980"
              Padding="32,28,32,40"
              HorizontalAlignment="Stretch">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="20" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock services:Localized.Key="NfcHeader.Text"
                           Style="{StaticResource SectionTitleStyle}"
                           FontSize="28" />
                <Button x:Name="ScanButton"
                        Grid.Column="1"
                        Style="{StaticResource PrimaryButtonStyle}"
                        Click="ScanButton_Click">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon x:Name="ScanIcon" Glyph="&#xE839;" FontSize="15" />
                        <TextBlock x:Name="ScanLabel" services:Localized.Key="StartNfcScan.Content" />
                    </StackPanel>
                </Button>
            </Grid>

            <Grid x:Name="ContentGrid"
                  Grid.Row="2"
                  ColumnSpacing="16"
                  RowSpacing="16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition x:Name="SummaryColumn" Width="2*" />
                    <ColumnDefinition x:Name="ContentColumn" Width="3*" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <Border Style="{StaticResource PanelBorderStyle}">
                    <StackPanel Spacing="14">
                        <TextBlock services:Localized.Key="NfcTagHeader.Text"
                                   FontSize="17"
                                   FontWeight="SemiBold" />
                        <StackPanel Spacing="4">
                            <TextBlock services:Localized.Key="NfcUidLabel.Text"
                                       Foreground="{StaticResource TextSecondaryBrush}" />
                            <TextBlock x:Name="UidText"
                                       FontFamily="Consolas"
                                       FontSize="12"
                                       Text="-"
                                       TextWrapping="NoWrap" />
                        </StackPanel>
                        <StackPanel Spacing="4">
                            <TextBlock services:Localized.Key="NfcTypeLabel.Text"
                                       Foreground="{StaticResource TextSecondaryBrush}" />
                            <TextBlock x:Name="TagTypeText" Text="-" TextWrapping="Wrap" />
                        </StackPanel>
                    </StackPanel>
                </Border>

                <Border x:Name="ParsedPanel"
                        Grid.Column="1"
                        Style="{StaticResource PanelBorderStyle}">
                    <StackPanel Spacing="12">
                        <TextBlock services:Localized.Key="NfcParsedContentHeader.Text"
                                   FontSize="17"
                                   FontWeight="SemiBold" />
                        <TextBlock x:Name="ParsedKindText"
                                   Foreground="{StaticResource TextSecondaryBrush}" />
                        <TextBox x:Name="ParsedContentText"
                                 MinHeight="92"
                                 IsReadOnly="True"
                                 AcceptsReturn="True"
                                 TextWrapping="Wrap" />
                    </StackPanel>
                </Border>

                <Border x:Name="RawPanel"
                        Grid.Row="1"
                        Grid.ColumnSpan="2"
                        Style="{StaticResource PanelBorderStyle}">
                    <StackPanel Spacing="12">
                        <TextBlock services:Localized.Key="NfcRawContentHeader.Text"
                                   FontSize="17"
                                   FontWeight="SemiBold" />
                        <TextBox x:Name="RawContentText"
                                 MinHeight="180"
                                 MaxHeight="320"
                                 FontFamily="Consolas"
                                 FontSize="12"
                                 IsReadOnly="True"
                                 AcceptsReturn="True"
                                 TextWrapping="NoWrap"
                                 ScrollViewer.HorizontalScrollBarVisibility="Auto"
                                 ScrollViewer.VerticalScrollBarVisibility="Auto" />
                    </StackPanel>
                </Border>
            </Grid>
        </Grid>
    </ScrollViewer>
</UserControl>
